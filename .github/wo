
name: Deploy to GitHub Pages
on:
  push:
    branches:
      - main

  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      # Get latest GitHub code
      - name: Checkout
        uses: actions/checkout@v4

      # Setup Node.js
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: my-app/my-app/package-lock.json

      # Install packages
      - name: Install dependencies
        working-directory: my-app/my-app
        run: npm ci

      # Build Next.js static website
      - name: Build static site
        working-directory: my-app/my-app
        run: npm run build
        env:
          NEXT_PUBLIC_API_BASE_URL: "https://propstoxx-next-639395118020.asia-south1.run.app"
          NEXT_PUBLIC_BASE_PATH: "/LandingPage"

      # Upload generated website
      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v4
        with:
          path: my-app/my-app/out

  deploy:
    needs: build
    runs-on: ubuntu-latest

    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
